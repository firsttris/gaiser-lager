# Production database — used ONLY by `npm run db:clone`, which reads it with
# pg_dump and never writes to it. Copy to .env.prod (git-ignored); Vite never
# loads this file, so the app itself can't connect to production from here.
#
# Supabase Dashboard → Connect → "Session pooler" connection string
# (IPv4-capable), with the database password filled in (percent-encoded).
PROD_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Public project URL, used to copy the material images (public bucket).
PROD_SUPABASE_URL=https://<project-ref>.supabase.co
