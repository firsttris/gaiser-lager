# Local development only. `npm run db:start` writes this file automatically
# with the keys of the local Supabase; there's normally no need to edit it.
#
# Production credentials do NOT belong here: they live in Vercel's environment
# variables, and the read-only clone credentials in .env.prod
# (see .env.prod.example). `npm run dev` refuses to start against a remote
# database.

# Public — Vite exposes VITE_-prefixed vars to the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only — NEVER prefix with VITE_. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Encrypts the httpOnly session cookies (`openssl rand -base64 32`).
SESSION_SECRET=
